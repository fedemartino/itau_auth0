# Auth0 Configuration
# 1. Create a free Auth0 account at https://auth0.com/
# 2. Create a Single Page Application
# 3. Copy your Domain and Client ID below
# 4. Set Allowed Callback URLs:  http://localhost:5173/callback
# 5. Set Allowed Logout URLs:    http://localhost:5173
# 6. Set Allowed Web Origins:    http://localhost:5173

VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here
